{
  "index_patterns": [
    "${index_pattern}"
  ],
  "template": {
    "settings": {
      "number_of_shards": 5,
      "number_of_replicas": 0,
      "index.plugins.index_state_management.policy_id": "${policy_id}"
    },
    "mappings": {
      "properties": {
        "id": {
          "type": "keyword"
        },
        "@timestamp": {
          "type": "date",
          "format": "epoch_millis"
        },
        "ttl": {
          "type": "integer"
        },
        "appId": {
          "type": "keyword"
        },
        "artifact": {
          "type": "keyword"
        },
        "domain": {
          "type": "keyword"
        },
        "start": {
          "type": "date"
        },
        "end": {
          "type": "date"
        },
        "env": {
          "type": "keyword"
        },
        "hostname": {
          "type": "keyword"
        },
        "requestId": {
          "type": "keyword"
        },
        "version": {
          "type": "keyword"
        },
        "indexedKeyValues": {
          "type": "nested",
          "properties": {
            "key": {
              "type": "keyword"
            },
            "value": {
              "type": "keyword"
            },
            "valueInteger": {
              "type": "integer"
            },
            "valueFloat": {
              "type": "float"
            },
            "valueDate": {
              "type": "date"
            }
          }
        },
        "audits": {
          "type": "object",
          "properties": {
            "type": {
              "type": "keyword"
            },
            "events": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
