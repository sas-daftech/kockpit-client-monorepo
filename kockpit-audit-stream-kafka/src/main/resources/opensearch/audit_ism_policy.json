{
  "policy": {
    "description": "Rollover policy based on 30GB size or 1 day age",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "timeout": "12h",
            "retry": {
              "count": 3,
              "backoff": "exponential",
              "delay": "1m"
            },
            "rollover": {
              "min_size": "30gb",
              "min_index_age": "1d"
            }
          }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "${delete_min_index_age}"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "timeout": "1h",
            "retry": {
              "count": 3,
              "backoff": "exponential",
              "delay": "1m"
            },
            "delete": {}
          }
        ]
      }
    ]
  }
}
